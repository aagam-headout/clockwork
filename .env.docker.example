# Local Docker stack — copy to .env.docker and fill in the two real keys.
#
#   cp .env.docker.example .env.docker

# Postgres in the compose stack. `db` is the service hostname; from your host
# machine the same database is on localhost:5444.
DATABASE_URL=postgres://clockwork:clockwork@db:5432/clockwork
# drizzle-kit wants a direct connection — locally there is no pooler, so it's
# the same URL.
DATABASE_URL_UNPOOLED=postgres://clockwork:clockwork@db:5432/clockwork

# Neon Auth is a hosted service with no local equivalent. Locally the single
# user is simply the owner. Development-only: it is ignored outright by a
# production build. Never set this in a deployed environment.
LOCAL_AUTH_BYPASS=true
OWNER_EMAIL=you@example.com

# createNeonAuth() is constructed at module load regardless of
# LOCAL_AUTH_BYPASS, so these must be non-empty even when bypassed. Any
# values work locally — they're never hit while the bypass is on.
NEON_AUTH_BASE_URL=http://localhost:3000
# Must be >= 32 chars. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Shared secret between the ticker container and /api/cron/tick.
CRON_SECRET=local-dev-secret
# How often the local ticker fires, in seconds. 300 matches production.
TICK_INTERVAL_SECONDS=300

# Remote services with no local stand-in — real keys required for a run to do
# anything. Without them the app still boots; runs fail with a clear error.
COMPOSIO_API_KEY=
AI_GATEWAY_API_KEY=

# Only needed if you want Composio event triggers to reach the local stack —
# point APP_URL at a tunnel (e.g. `ngrok http 3000`) and paste the webhook
# secret from the Composio dashboard.
APP_URL=http://localhost:3000
COMPOSIO_WEBHOOK_SECRET=

# Runs older than this are pruned on each tick.
RUN_RETENTION_DAYS=30
