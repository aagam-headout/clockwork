# Deploying to your own Vercel account? Use the one-click flow in
# SELF-HOSTING.md instead — it provisions the database and prompts for the four
# secrets below. This file is for running `pnpm dev` against cloud services.
# For the local Docker stack, use .env.docker.example.
#
#   cp .env.example .env.local

# --- Provisioned for you on Vercel ------------------------------------------
# The Neon Marketplace integration injects both of these. Running locally, copy
# them from your Neon project — pooled for the app, direct for migrations
# (PgBouncer transaction mode can't run what drizzle-kit issues).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Secrets you generate ---------------------------------------------------
# Encrypts users' model-provider API keys at rest (AES-256-GCM). Required in any
# deployed environment; without it, saving or reading a key fails.
#
#   openssl rand -base64 32
#
# To rotate: set ENCRYPTION_KEY_V2, then ENCRYPTION_KEY_VERSION=v2. Rows sealed
# with v1 keep decrypting as long as ENCRYPTION_KEY is still present.
ENCRYPTION_KEY=

# Signs session cookies. Must be >= 32 chars: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Shared secret the scheduler presents to /api/cron/tick.
# Vercel Cron attaches it automatically; the GitHub Actions workflow needs the
# same value as a repo secret. openssl rand -base64 32
CRON_SECRET=

# --- Remote services --------------------------------------------------------
# App-wide. Users get their own Composio *identity* (namespaced by
# COMPOSIO_USER_NS), not their own key. Create a project at app.composio.dev.
COMPOSIO_API_KEY=

# Set this on preview deploys that share a Composio key with production, so
# their connected accounts can never collide. Defaults to "cw".
# COMPOSIO_USER_NS=cw-preview

# --- Optional ---------------------------------------------------------------
# Both default to this deployment's own domain via VERCEL_PROJECT_PRODUCTION_URL.
# Set them only for a custom domain, or locally where that variable is absent.
# APP_URL=http://localhost:3000
# NEON_AUTH_BASE_URL=http://localhost:3000

# Needed only for Composio event triggers — paste the webhook signing secret
# from the Composio dashboard. Locally, point APP_URL at a tunnel first.
# COMPOSIO_WEBHOOK_SECRET=

# Runs older than this are pruned on each tick. Defaults to 30.
# RUN_RETENTION_DAYS=30
